# ============================================================
# BEAN — SIGNATURESI
# Environment variables template
#
# Copy this file to:
#   .env.local
#
# Never commit .env.local to GitHub.
# ============================================================


# ------------------------------------------------------------
# APP
# ------------------------------------------------------------

VITE_APP_NAME=Bean
VITE_APP_ENV=development


# ------------------------------------------------------------
# SIGNATURESI IDENTITY
# Central account / identity service used across Signaturesi apps.
# ------------------------------------------------------------

VITE_ACCOUNTS_URL=https://accounts.signaturesi.com


# ------------------------------------------------------------
# SUPABASE
# Browser-safe values only.
# ------------------------------------------------------------

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE


# ------------------------------------------------------------
# REALTIME
# Private channels will be used for Bean presence,
# typing, calls and conversation events.
# ------------------------------------------------------------

VITE_REALTIME_ENABLED=true


# ------------------------------------------------------------
# FEATURE FOUNDATION
# These are local defaults only.
# Production rollout will later come from feature flags.
# ------------------------------------------------------------

VITE_FEATURE_VOICE_CALLS=false
VITE_FEATURE_VIDEO_CALLS=false
VITE_FEATURE_BEANMOJI_3D=false
VITE_FEATURE_DISCOVER=false
VITE_FEATURE_WORK=false
